# Root-level environment overrides for `docker compose up`.
#
# These are read by docker-compose.yml to configure the Postgres container
# and are passed through to the backend's DATABASE_URL. They are NOT used
# by a non-Docker local run -- for that, see backend/.env.example and
# frontend/.env.example instead.
#
# No real secrets belong here or in any .env file in this repo. These are
# placeholder values for a local/demo Postgres instance only.

# --- Postgres (used by the `postgres` service in docker-compose.yml) ---
POSTGRES_USER=first_hour
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=first_hour

# --- Backend (passed through to the `backend` service) ---
# Demo mode gates /demo/inject-incident and /demo/reset. Never enable
# against a real Razorpay workspace or production data.
DEMO_MODE=true
SEED=42

# Optional: only needed if you wire in real vision/OCR evidence extraction
# (see backend/app/services/evidence/pipeline.py). The shipped demo never
# calls this even if it is set.
ANTHROPIC_API_KEY=

# --- Frontend (build-time; see frontend/.env.example) ---
# Leave unset to use the nginx reverse proxy baked into the frontend
# container (see frontend/nginx.conf) -- this is the default and the
# recommended setting for `docker compose up`.
VITE_API_BASE_URL=
