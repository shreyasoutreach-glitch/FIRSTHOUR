# Relative API path is intentional for production. Vercel proxies /api/* to Render.
VITE_API_BASE_URL=

# Set VITE_AUTH_REQUIRED=true for the production workspace.
# Auth0 is used as the OIDC provider for the browser login.
VITE_AUTH_REQUIRED=false
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
