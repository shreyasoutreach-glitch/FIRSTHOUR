# Primhora backend configuration

# Local dev default: SQLite file. For production-shaped runs (or docker-compose),
# point this at Postgres instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://firsthour:firsthour@localhost:5432/firsthour
DATABASE_URL=sqlite:///./first_hour.db

# Turns on the deterministic synthetic universe + flagship incident + demo endpoints.
# Never enable against a real Razorpay workspace.
DEMO_MODE=true

# Fixed seed so the synthetic universe and flagship incident are reproducible.
SEED=42

# Where uploaded evidence artifacts are stored (local object storage stand-in).
EVIDENCE_STORAGE_DIR=./storage/evidence

# Optional. If set, the evidence extraction service can use Gemini to locate
# source snippets in text/images/PDFs. Financial claims remain unverified until
# deterministic cross-reference against canonical records succeeds.
GEMINI_API_KEY=

CORS_ORIGINS=http://localhost:5173
